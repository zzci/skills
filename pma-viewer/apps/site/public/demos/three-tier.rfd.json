  "edges": [
    { "id": "e1", "source": "user", "target": "cdn", "type": "flow", "label": "HTTPS" },
    { "id": "e2", "source": "cdn", "target": "web", "type": "flow" },
    { "id": "e3", "source": "web", "target": "api", "type": "flow", "label": "REST" },

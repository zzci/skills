    { "id": "e6", "source": "worker", "target": "queue", "type": "stream", "label": "consume", "animated": true },
    { "id": "e7", "source": "api", "target": "queue", "type": "stream", "label": "enqueue", "animated": true },
    { "id": "e8", "source": "worker", "target": "s3", "type": "flow", "label": "upload" },
    { "id": "e9", "source": "worker", "target": "db", "type": "flow" }

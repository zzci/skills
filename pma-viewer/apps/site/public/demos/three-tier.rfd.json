{
  "schema": "pma-draw/v1",
  "type": "reactflow",
  "metadata": {
    "title": "3-Tier SaaS",
    "description": "Browser → CDN → API → DB + Cache. Classic web app topology.",
    "palette": "default",
    "layout": "auto-lr"
  },
  "viewport": { "x": 0, "y": 0, "zoom": 0.85 },
  "nodes": [
    { "id": "user", "type": "user", "position": { "x": 0, "y": 180 }, "data": { "label": "End User", "subtitle": "Browser" } },
    { "id": "cdn", "type": "security", "position": { "x": 240, "y": 180 }, "data": { "label": "CDN / WAF", "subtitle": "Cloudflare", "badges": ["TLS", "DDoS"] } },
    { "id": "web", "type": "frontend", "position": { "x": 480, "y": 180 }, "data": { "label": "Web App", "subtitle": "React SPA", "badges": ["TypeScript", "Vite"] } },

    { "id": "group__api", "type": "group", "position": { "x": 720, "y": 60 }, "style": { "width": 260, "height": 380 }, "data": { "label": "API Tier", "color": "backend", "dashed": true } },
    { "id": "api", "type": "backend", "position": { "x": 30, "y": 60 }, "parentNode": "group__api", "extent": "parent", "data": { "label": "API Server", "subtitle": "Fastify + Zod", "badges": ["REST", "Auth"] } },
    { "id": "worker", "type": "backend", "position": { "x": 30, "y": 220 }, "parentNode": "group__api", "extent": "parent", "data": { "label": "Worker", "subtitle": "BullMQ", "badges": ["Jobs"] } },

    { "id": "cache", "type": "cache", "position": { "x": 1040, "y": 80 }, "data": { "label": "Cache", "subtitle": "Redis 7" } },
    { "id": "queue", "type": "queue", "position": { "x": 1040, "y": 300 }, "data": { "label": "Job Queue", "subtitle": "Redis Streams" } },

    { "id": "db", "type": "database", "position": { "x": 1300, "y": 140 }, "data": { "label": "Primary DB", "subtitle": "Postgres 16", "badges": ["Primary"] } },
    { "id": "s3", "type": "storage", "position": { "x": 1300, "y": 320 }, "data": { "label": "Object Store", "subtitle": "S3 / R2" } }

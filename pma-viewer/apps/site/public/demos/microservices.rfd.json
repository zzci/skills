    { "id": "ses", "type": "external", "position": { "x": 1220, "y": 280 }, "data": { "label": "SES", "subtitle": "Email" }, "targetPosition": "left" },

    { "id": "obs", "type": "monitoring", "position": { "x": 100, "y": 500 }, "data": { "label": "Observability", "subtitle": "Prometheus + Loki + Tempo", "badges": ["OTel"] } }

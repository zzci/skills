{
  "schema": "pma-draw/v1",
  "type": "reactflow",
  "metadata": {
    "title": "Microservices",
    "description": "Gateway + domain services + event bus + observability stack.",
    "palette": "default",
    "layout": "auto-lr"
  },
  "viewport": { "x": 0, "y": 0, "zoom": 0.75 },
  "nodes": [
    { "id": "user", "type": "user", "position": { "x": 0, "y": 260 }, "data": { "label": "Client", "subtitle": "Mobile + Web" } },
    { "id": "gateway", "type": "orchestrator", "position": { "x": 240, "y": 260 }, "data": { "label": "API Gateway", "subtitle": "Kong", "badges": ["JWT", "RBAC"] } },

    { "id": "group__svc", "type": "group", "position": { "x": 500, "y": 80 }, "style": { "width": 260, "height": 560 }, "data": { "label": "Domain Services", "color": "backend", "dashed": true } },
    { "id": "users", "type": "backend", "position": { "x": 30, "y": 60 }, "parentNode": "group__svc", "extent": "parent", "data": { "label": "Users", "subtitle": "Go / gRPC" } },
    { "id": "orders", "type": "backend", "position": { "x": 30, "y": 210 }, "parentNode": "group__svc", "extent": "parent", "data": { "label": "Orders", "subtitle": "Node / REST" } },
    { "id": "billing", "type": "backend", "position": { "x": 30, "y": 360 }, "parentNode": "group__svc", "extent": "parent", "data": { "label": "Billing", "subtitle": "Rust / gRPC" } },
    { "id": "notify", "type": "backend", "position": { "x": 30, "y": 470 }, "parentNode": "group__svc", "extent": "parent", "data": { "label": "Notifier", "subtitle": "Python" } },

    { "id": "bus", "type": "queue", "position": { "x": 820, "y": 260 }, "data": { "label": "Event Bus", "subtitle": "Kafka", "badges": ["3 brokers"] } },

    { "id": "group__data", "type": "group", "position": { "x": 1080, "y": 80 }, "style": { "width": 260, "height": 440 }, "data": { "label": "Data Stores", "color": "database", "dashed": true } },
    { "id": "pg", "type": "database", "position": { "x": 30, "y": 60 }, "parentNode": "group__data", "extent": "parent", "data": { "label": "Postgres", "subtitle": "OLTP" } },
    { "id": "mongo", "type": "database", "position": { "x": 30, "y": 200 }, "parentNode": "group__data", "extent": "parent", "data": { "label": "MongoDB", "subtitle": "catalog" } },
    { "id": "s3", "type": "storage", "position": { "x": 30, "y": 340 }, "parentNode": "group__data", "extent": "parent", "data": { "label": "S3", "subtitle": "invoices" } },

    { "id": "stripe", "type": "external", "position": { "x": 1400, "y": 560 }, "data": { "label": "Stripe", "subtitle": "Payments" } },
    { "id": "ses", "type": "external", "position": { "x": 1080, "y": 560 }, "data": { "label": "SES", "subtitle": "Email" } },

    { "id": "obs", "type": "monitoring", "position": { "x": 240, "y": 560 }, "data": { "label": "Observability", "subtitle": "Prometheus + Loki + Tempo", "badges": ["OTel"] } }
  ],
  "edges": [
    { "id": "e1", "source": "user", "target": "gateway", "type": "flow" },
    { "id": "e2", "source": "gateway", "target": "users", "type": "flow" },
    { "id": "e3", "source": "gateway", "target": "orders", "type": "flow" },
    { "id": "e4", "source": "gateway", "target": "billing", "type": "flow" },

    { "id": "e5", "source": "orders", "target": "bus", "type": "stream", "label": "order.created", "animated": true },
    { "id": "e6", "source": "billing", "target": "bus", "type": "stream", "label": "invoice.paid", "animated": true },
    { "id": "e7", "source": "bus", "target": "notify", "type": "stream", "animated": true },

    { "id": "e8", "source": "users", "target": "pg", "type": "flow" },
    { "id": "e9", "source": "orders", "target": "mongo", "type": "flow" },
    { "id": "e10", "source": "billing", "target": "s3", "type": "flow", "label": "PDF" },

    { "id": "e11", "source": "billing", "target": "stripe", "type": "flow", "label": "charge" },
    { "id": "e12", "source": "notify", "target": "ses", "type": "flow" },

    { "id": "e13", "source": "gateway", "target": "obs", "type": "dependency" },
    { "id": "e14", "source": "billing", "target": "obs", "type": "dependency" }
  ]
}
